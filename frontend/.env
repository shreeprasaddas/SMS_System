# Frontend Environment Configuration - LOCAL DEVELOPMENT

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Application
VITE_APP_NAME=School Management System
VITE_APP_DESCRIPTION=Complete School Management System

# Authentication
VITE_JWT_STORAGE_KEY=sms_access_token
VITE_REFRESH_TOKEN_KEY=sms_refresh_token

# Features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REPORTING=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_NOTIFICATIONS=true

# Environment
VITE_ENV=development
VITE_DEBUG=true
