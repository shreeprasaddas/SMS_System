# Application
NODE_ENV=development
PORT=5000
APP_NAME=SMS Backend
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/sms
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRE=30d

# TOTP/MFA
TOTP_WINDOW=1
TOTP_TIME_STEP=30

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=sms-bucket
AWS_S3_URL=https://sms-bucket.s3.amazonaws.com

# Email (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=School Management System
MAIL_FROM_EMAIL=noreply@sms.school

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Payments (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_SECRET_KEY=your-razorpay-secret

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,xlsx,xls

# Pagination
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# API
API_VERSION=v1
API_PREFIX=/api/v1

# Session
SESSION_EXPIRY=24h
SESSION_REFRESH_THRESHOLD=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Scheduler (Cron)
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *

# Frontend
FRONTEND_URL=http://localhost:3000

# Google Maps (Optional)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Sentry (Error Tracking - Optional)
SENTRY_DSN=

# Debug
DEBUG=false
VERBOSE_LOGGING=false
