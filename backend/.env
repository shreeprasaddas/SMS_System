# ========================================
# LOCAL DEVELOPMENT CONFIGURATION
# ========================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME=SMS Backend
LOG_LEVEL=debug

# ========================================
# DATABASE & CACHE
# ========================================

# MongoDB (Local)
MONGODB_URI=mongodb://localhost:27017/sms_local
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis (Local)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ========================================
# AUTHENTICATION & SECURITY
# ========================================

# JWT Keys (Change in production!)
JWT_SECRET=sms-dev-jwt-secret-key-do-not-use-in-production-12345678901234567890
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=sms-dev-refresh-secret-key-do-not-use-in-production-1234567890
JWT_REFRESH_EXPIRE=30d

# TOTP/MFA Settings
TOTP_WINDOW=1
TOTP_TIME_STEP=30

# Encryption
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=sms-dev-encryption-key-32-chars-12345678

# ========================================
# CORS & FRONTEND
# ========================================

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000
CORS_CREDENTIALS=true
FRONTEND_URL=http://localhost:3000

# ========================================
# EMAIL (Nodemailer - Local/Dev)
# ========================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=School Management System
MAIL_FROM_EMAIL=noreply@sms.school

# ========================================
# SMS (Twilio - Optional for local)
# ========================================

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# PAYMENT GATEWAY (Optional for local)
# ========================================

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_SECRET_KEY=your-razorpay-secret-key

# ========================================
# AWS S3 (Optional - Can use local storage)
# ========================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=sms-local-bucket
AWS_S3_URL=https://sms-local-bucket.s3.amazonaws.com

# ========================================
# FILE UPLOAD
# ========================================

MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,xlsx,xls,csv

# ========================================
# PAGINATION
# ========================================

DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# ========================================
# API CONFIGURATION
# ========================================

API_VERSION=v1
API_PREFIX=/api/v1

# ========================================
# SESSION & RATE LIMITING
# ========================================

SESSION_EXPIRY=24h
SESSION_REFRESH_THRESHOLD=1h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# SCHEDULER (Cron Jobs)
# ========================================

ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# ========================================
# BACKUP
# ========================================

BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *

# ========================================
# GOOGLE MAPS (Optional)
# ========================================

GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ========================================
# ERROR TRACKING (Optional)
# ========================================

SENTRY_DSN=

# ========================================
# DEBUG MODE
# ========================================

DEBUG=true
VERBOSE_LOGGING=true
